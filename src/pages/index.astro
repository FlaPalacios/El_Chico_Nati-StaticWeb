---
// Portada: hero con carrusel de 3 paneles, catálogo con filtros y franja de servicio.
import Base from '../layouts/Base.astro';
import HeroCarrusel from '../components/HeroCarrusel.astro';
import Catalogo from '../components/Catalogo.astro';
import productos from '../data/productos.json';
import categorias from '../data/categorias.json';
import marcas from '../data/marcas.json';
import envio from '../data/envio.json';
import { soles } from '../lib/formato.js';

const tarifaLima = envio.zonas[0]?.tarifa;
---
<Base titulo="El Chico Naturista">
  <main>
    <HeroCarrusel />
    <Catalogo productos={productos} categorias={categorias} marcas={marcas} />
    <section class="servicio contenedor" aria-label="Cómo trabajamos">
      <p><strong>Envío gratis desde {soles(envio.gratisDesde)}</strong>A todo el Perú.{tarifaLima ? ` En Lima y Callao el envío cuesta ${soles(tarifaLima)}.` : ''}</p>
      <p><strong>Delivery el mismo día en Lima</strong>Confirmamos disponibilidad y hora por WhatsApp.</p>
      <p><strong>Pagas al confirmar</strong>Yape, Plin o transferencia bancaria.</p>
    </section>
  </main>
</Base>

<style>
  .servicio { display: grid; gap: 16px; margin-top: 48px; padding-top: 28px; border-top: 2px solid var(--jade); }
  .servicio p { margin: 0; }
  .servicio strong { display: block; font: 700 1.1875rem/1.2 var(--losa); }
  @media (min-width: 900px) { .servicio { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
</style>
