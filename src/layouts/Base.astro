---
// Layout de todas las páginas: cabecera fija, contenido, pie y botón de WhatsApp.
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import PanelCarrito from '../components/PanelCarrito.astro';
import productos from '../data/productos.json';
import { fotoCuadro } from '../lib/cloudinary.js';
import { tienda } from '../data/tienda.js';

interface Props {
  titulo: string;
  descripcion?: string;
  mensajeWhatsapp?: string;
}

const {
  titulo,
  descripcion = `${tienda.lema}. Pide por WhatsApp; delivery el mismo día en Lima y envíos a todo el país.`,
  mensajeWhatsapp,
} = Astro.props;
// Catálogo vigente para el carrito: solo lo público que hace falta para pintar líneas y sumar.
// Va en un atributo (Astro lo escapa); el navegador lo lee con JSON.parse.
const catalogoCarrito = JSON.stringify(Object.fromEntries(productos.map((p) => [p.codigo, {
  nombre: p.nombre, presentacion: p.presentacion, precio: p.precio, slug: p.slug, foto: p.imagenes[0] ? fotoCuadro(p.imagenes[0], 176) : '',
}])));
const tituloCompleto = titulo === tienda.nombre ? titulo : `${titulo} · ${tienda.nombre}`;
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mientras no sea v1.0: fuera de buscadores (PLAN-v2.md, Fase 6) -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={descripcion} />
    <!-- Única excepción a "colores solo en global.css": meta theme-color no admite var(). Es --papel. -->
    <meta name="theme-color" content="#FFFFFF" />
    <title>{tituloCompleto}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/zilla-slab-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hind-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Cabecera />
    <div class="contenido"><slot /></div>
    <Pie />
    <BotonWhatsapp mensaje={mensajeWhatsapp} />
    <PanelCarrito />
    <div class="aviso" data-aviso role="status" aria-live="polite"></div>
    <div hidden data-catalogo-carrito={catalogoCarrito}></div>
    <script>
      import '../scripts/tienda.js';
      import '../scripts/carrito.js';
      import '../scripts/alpine.js';
    </script>
  </body>
</html>

<style is:global>
  .aviso { position: fixed; left: 50%; bottom: 88px; z-index: 6; translate: -50% 0; width: max-content; max-width: calc(100vw - 32px); padding: 10px 16px; border-radius: 20px; background: var(--monte); color: var(--papel); text-align: center; opacity: 0; transition: opacity var(--rapido); pointer-events: none; }
  .aviso.visible { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .aviso { transform: translateY(8px); transition: opacity var(--rapido), transform .3s var(--curva); }
    .aviso.visible { transform: none; }
  }
</style>
